# Automatically detect text files.
* text=auto

# Keep source and project files as LF across platforms.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows scripts should use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf